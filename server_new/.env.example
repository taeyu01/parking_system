# 이 파일을 복사해서 .env 로 만들고 값을 채우세요. (.env는 Git에 올리지 않기)
# 주석은 줄 맨 앞에 # 을 붙이면 됩니다. 값에는 따옴표나 공백을 붙이지 마세요.
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=여기에_비밀번호
DB_NAME=parking
SERVER_PORT=5000

# ---- 아래는 선택 설정입니다. 필요할 때만 # 을 지우고 값을 바꾸세요. (안 적으면 괄호 안 기본값) ----
# SLOT_MINUTES=30             # 이용 시간 선택 단위(분). 시연할 때 짧게 보고 싶으면 5로
# DEFAULT_DURATION_MINUTES=120 # 이용 시간을 안 보냈을 때 기본값(분)
# MAX_DURATION_MINUTES=720    # 예약 하나의 최대 이용 시간(분)
# BUFFER_MINUTES=15           # 같은 칸 예약 사이에 필요한 간격(분)
# ENTRY_EARLY_MINUTES=10      # 시작 몇 분 전부터 입장할 수 있는지
# NOSHOW_MINUTES=30           # 시작 후 몇 분이 지나면 노쇼로 자동 취소할지
# ALERT_MINUTES=10            # 종료 몇 분 전부터 알림(alert)을 줄지
# EXIT_REQUEST_MINUTES=5      # [이용 종료] 후 차단봉 열기 요청이 유효한 시간(분)
# MIN_GAP_MINUTES=60          # 예약 사이 빈 시간이 이보다 짧으면 예약 불가(분)
